        Rmid: Rmid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUHS>,
                <&macro_release>,
                <&kp NUHS &kp LSHFT>;

            label = "RMID";
        };

        wintab: wintab {
