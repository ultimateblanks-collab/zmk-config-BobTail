#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        L_MKK {
            bindings = <&kp RBKT>;
            key-positions = <2 12>;
        };

        R_MKK {
            bindings = <&kp NUHS>;
            key-positions = <7 19>;
        };

        DQC {
            bindings = <&dq>;
            key-positions = <18 30>;
        };

        SQC {
            bindings = <&sq>;
            key-positions = <19 31>;
        };

        L_KK {
            bindings = <&l_kakko>;
            key-positions = <3 13>;
        };

        R_KK {
            bindings = <&r_kakko>;
            key-positions = <6 18>;
        };

        underS {
            bindings = <&us>;
            key-positions = <17 29>;
        };

        anp {
            bindings = <&anp>;
            key-positions = <20 32>;
        };

        Rmid {
            bindings = <&Rmid>;
            key-positions = <8 20>;
        };

        Lmid {
            bindings = <&Lmid>;
            key-positions = <1 11>;
        };

        pl {
            bindings = <&pl>;
            key-positions = <14 26>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        ctPLMI: ctPLMI {
            compatible = "zmk,behavior-sensor-rotate";
            label = "CTPLMI";
            #sensor-binding-cells = <0>;
            bindings = <&ctrlPLUS>, <&ctrlMINUS>;

            tap-ms = <20>;
        };

        mkp45: mkp45 {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MKP45";
            #sensor-binding-cells = <0>;
            bindings = <&mkp MB4>, <&mkp MB5>;

            tap-ms = <20>;
        };

        appch: appch {
            compatible = "zmk,behavior-sensor-rotate";
            label = "APPCH";
            #sensor-binding-cells = <0>;
            bindings = <&altesc>, <&saltesc>;

            tap-ms = <20>;
        };

        pgupdn: pgupdn {
            compatible = "zmk,behavior-sensor-rotate";
            label = "PGUPDN";
            #sensor-binding-cells = <0>;
            bindings = <&kp PG_UP>, <&kp PG_DN>;

            tap-ms = <20>;
        };

        L_HRM: L_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 17 18 19 20 21 29 30 31 32 33 41 42 16 28 40>;
            hold-trigger-on-release;
        };

        R_HRM: R_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "R_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        THUMB_MO_R: THUMB_MO_R {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MO_R";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        COMDQ: COMDQ {
            compatible = "zmk,behavior-tap-dance";
            label = "COMDQ";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&dq>;
        };

        MB45: MB45 {
            compatible = "zmk,behavior-tap-dance";
            label = "MB45";
            #binding-cells = <0>;
            bindings = <&mkp MB4>, <&mkp MB5>;
        };

        THUMB_MO_L: THUMB_MO_L {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MO_L";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
        };

        MOL: MOL {
            compatible = "zmk,behavior-hold-tap";
            label = "MOL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            require-prior-idle-ms = <170>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        comUS: comUS {
            compatible = "zmk,behavior-tap-dance";
            label = "COMUS";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&us>;
        };

        periPL: periPL {
            compatible = "zmk,behavior-tap-dance";
            label = "PERIPL";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&pl>;
        };
    };

    macros {
        exc: exc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUMBER_1>,
                <&macro_release>,
                <&kp NUMBER_1 &kp LSHFT>;

            label = "EXC";
        };

        dq: dq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUMBER_2>,
                <&macro_release>,
                <&kp NUMBER_2 &kp LSHFT>;

            label = "DQ";
        };

        hush: hush {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUMBER_3>,
                <&macro_release>,
                <&kp NUMBER_3 &kp LSHFT>;

            label = "HUSH";
        };

        dollar: dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp NUMBER_4 &kp LSHFT>;

            label = "DOLLAR";
        };

        percent: percent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp N5>,
                <&macro_release>,
                <&kp N5 &kp LSHFT>;

            label = "PERCENT";
        };

        anp: anp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUMBER_6>,
                <&macro_release>,
                <&kp NUMBER_6 &kp LSHFT>;

            label = "ANP";
        };

        sq: sq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp N7>,
                <&macro_release>,
                <&kp N7 &kp LSHFT>;

            label = "SQ";
        };

        l_kakko: l_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp N8>,
                <&macro_release>,
                <&kp N8 &kp LSHFT>;

            label = "L_KAKKO";
        };

        r_kakko: r_kakko {
