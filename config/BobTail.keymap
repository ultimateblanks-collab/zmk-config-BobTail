        };

        ctrlRIGHT: ctrlRIGHT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RIGHT &kp LCTRL>;

            label = "CTRLRIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&L_HRM LWIN Q  &L_HRM LEFT_ALT W  &L_HRM LCTRL E  &L_HRM LSHFT R  &kp T                               &kp Y           &R_HRM RSHFT U  &R_HRM RCTRL I  &R_HRM RIGHT_ALT O  &R_HRM RWIN P
&kp A          &kp S              &kp D           &kp F           &kp G         &ctrlW       &menuTD  &kp H           &kp J           &kp K           &kp L               &hius
&kp Z          &kp X              &kp C           &kp V           &kp B         &ctrlT       &prscTD  &kp N           &kp M           &mkp MB1        &SPL5 5 MB2         &slpl
&kp TAB        &sq                &dq             &RT_COM 4 0     &RT_PERI 3 0  &ALTCTR      &SQDQ    &RT_SP 2 SPACE                                                      &kp ENTER
            >;

            sensor-bindings = <&ctPLMI>;
        };

        MB {
            bindings = <
&none  &none  &none  &none  &none                       &none     &kp HOME  &none  &kp END      &none
&none  &none  &none  &none  &none  &none      &none     &none     &mkp MB1  &none  &SPL5 5 MB2  &none
&none  &none  &none  &none  &none  &none      &none     &none     &none     &none  &none        &none
&none  &none  &none  &none  &none  &none      &mkp MB5  &mkp MB4                                &none
            >;
        };

        BASIC {
            bindings = <
&kp LWIN    &SP_CTPGUP LEFT_ALT 0  &SP_CTUP LCTRL 0  &SP_CTPGDN LSHIFT 0  &none                        &saltesc    &kp BACKSPACE   &kp UP_ARROW    &kp ESCAPE  &saltesc
&shiftHOME  &ctrlLEFT              &ctrlDOWN         &ctrlRIGHT           &shiftEND  &none      &none  &shiftHOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT   &shiftEND
&none       &ctHOME                &none             &ctEND               &none      &none      &none  &kp RWIN    &kp HOME        &kp DELETE      &kp END     &wintab
&sk LSHFT   &none                  &none             &none                &none      &none      &none  &none                                                   &CW
            >;

            sensor-bindings = <&appch>;
        };

        NUMFUN {
            bindings = <
&kp F1        &kp F2        &altF3        &kp F4        &kp F5                          &kp F6         &kp F7     &kp F8     &kp F9  &kp F10
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &altf11        &kp F12  &kp NUMBER_6   &kp N7     &kp N8     &kp N9  &kp N0
&kp PERIOD    &carte        &evalue       &none         &none   &kp EQUAL      &eql     &plus          &kp MINUS  &kp SLASH  &aster  &kp ENTER
&altf11       &none         &none         &none         &none   &none          &kp TAB  &kp BACKSPACE                                &kp F12
            >;

            sensor-bindings = <&idpass>;
        };

        SYMBOL {
            bindings = <
&none    &ctpgup    &ctrlUP    &ctpgdn     &none                       &kp INTERNATIONAL_3  &kp LBKT  &kp RBKT  &kp NUHS  &kp EQUAL
&ctHOME  &ctrlLEFT  &ctrlDOWN  &ctrlRIGHT  &ctEND  &none      &none    &dollar              &anp      &l_kakko  &r_kakko  &eql
&none    &none      &none      &none       &none   &none      &none    &none                &hush     &Lmid     &Rmid     &exc
&none    &none      &none      &none       &none   &none      &evalue  &kp BACKSPACE                                      &none
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
