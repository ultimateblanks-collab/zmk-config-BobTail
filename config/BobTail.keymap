        us: us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp INTERNATIONAL_1>,
                <&macro_release>,
                <&kp INTERNATIONAL_1 &kp LSHFT>;

            label = "US";
        };

        pl: pl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp INTERNATIONAL_3>,
                <&macro_release>,
                <&kp INTERNATIONAL_3 &kp LSHFT>;

            label = "PL";
        };

        eql: eql {
