            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp F11>,
                <&macro_release>,
                <&kp F11 &kp LEFT_ALT>;

            label = "ALTF11";
        };

        shiftapp: shiftapp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp K_CONTEXT_MENU>,
                <&macro_release>,
                <&kp K_CONTEXT_MENU &kp LSHFT>;

