                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp SINGLE_QUOTE>,
                <&macro_release>,
                <&kp SINGLE_QUOTE &kp LSHFT>;

            label = "ASTER";
        };

        altesc: altesc {
