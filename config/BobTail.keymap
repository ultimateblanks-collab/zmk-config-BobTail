    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W                &kp E             &kp R             &kp T                                         &kp Y                  &kp U              &kp I                  &kp O                  &kp P
&kp A            &kp S                &kp D             &kp F             &kp G              &mkp MCLK       &menuTD    &kp H                  &kp J              &kp K                  &kp L                  &TD_HIUS
&SP_ZXCV LWIN Z  &SP_ZXCV LEFT_ALT X  &SP_ZXCV LCTRL C  &SP_ZXCV LSHFT V  &kp B              &none           &prscTD    &kp N                  &SP_RIGHT LSHFT M  &SP_RIGHT LCTRL COMMA  &SP_RIGHT LALT PERIOD  &TD_SLASH
&evalue          &none                &kp ESCAPE        &kp TAB           &THUMB_MO 5 SPACE  &kp DELETE      &kp ENTER  &THUMB_MO 2 BACKSPACE                                                                   &carte
            >;

            sensor-bindings = <&appch>;
        };

        MB {
            bindings = <
&trans  &trans    &trans    &trans    &trans                        &trans    &trans    &trans    &trans    &trans
&trans  &mkp MB4  &mkp MB2  &mkp MB1  &mkp MB5  &trans      &trans  &mkp MB5  &mkp MB1  &mkp MB2  &mkp MB4  &trans
&trans  &trans    &trans    &trans    &trans    &trans      &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans    &trans      &trans  &trans                                  &trans
            >;
        };

        BASIC {
            bindings = <
&kp EQUAL  &kp LBKT                 &kp RBKT              &kp NUHS               &kp INTERNATIONAL_3                    &altesc   &ctpgup         &kp UP_ARROW    &ctpgdn       &saltesc
&SQDQ      &anp                     &l_kakko              &r_kakko               &dollar              &none      &none  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &kp END
&TD_2_Z    &SP_HUSHLALT LEFT_ALT 0  &SP_LMIDCTRL LCTRL 0  &SP_RMIDSHIFT LSHFT 0  &percent             &none      &none  &APPPRSC  &msc SCRL_DOWN  &wintab         &msc SCRL_UP  &none
&none      &none                    &evalue               &none                  &kp DEL              &none      &none  &none                                                   &none
            >;

            sensor-bindings = <&ctpgupdn>;
        };

        NUMFUN {
            bindings = <
&kp F1        &kp F2        &altF3        &kp F4        &kp F5                        &kp F6         &kp F7  &kp F8     &kp F9  &kp F10
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &none        &none    &kp NUMBER_6   &kp N7  &kp N8     &kp N9  &kp N0
&kp PERIOD    &none         &none         &none         &none   &altf11      &kp F12  &eql           &plus   &kp MINUS  &aster  &kp SLASH
&altf11       &none         &none         &none         &none   &none        &kp TAB  &kp BACKSPACE                             &kp F12
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        SCROLL {
            bindings = <
&none  &none  &none  &none  &none                       &none    &none     &none     &none  &none
&none  &none  &none  &none  &none  &none      &none     &none    &mkp MB4  &mkp MB5  &none  &none
&none  &none  &none  &none  &none  &none      &none     &none    &none     &none     &none  &none
&none  &none  &none  &none  &none  &none      &kp HOME  &kp END                             &none
            >;
        };

        NUM_FUN_2 {
            bindings = <
&kp F11  &kp F2  &kp F3  &kp F4  &kp F5                        &kp F6         &kp F7     &kp F8  &kp F9   &F1012
&kp N1   &kp N2  &kp N3  &kp N4  &kp N5  &none      &none      &kp N6         &kp N7     &kp N8  &kp N9   &kp N0
&none    &none   &none   &none   &none   &none      &none      &plus          &kp MINUS  &aster  &kp DOT  &kp SLASH
&none    &none   &none   &none   &none   &none      &kp ENTER  &kp BACKSPACE                              &none
            >;
        };

        SYMBOL {
            bindings = <
&kp EQUAL  &kp NUHS  &kp RBKT  &kp LBKT  &kp INTERNATIONAL_3                      &kp INTERNATIONAL_3  &kp RBKT  &kp NUHS  &kp LBKT  &kp EQUAL
&SQDQ      &l_kakko  &r_kakko  &anp      &dollar              &none      &none    &dollar              &l_kakko  &r_kakko  &anp      &USPL
&exc       &Lmid     &Rmid     &hush     &percent             &none      &none    &percent             &Lmid     &Rmid     &hush     &CORSEMI
&none      &none     &none     &none     &none                &none      &evalue  &kp BACKSPACE                                      &none
            >;
        };
    };
};
