            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp HOME>,
                <&macro_release>,
                <&kp HOME &kp LSHFT>;

            label = "SHIFTHOME";
        };

        shiftEND: shiftEND {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp END>,
                <&macro_release>,
                <&kp END &kp LSHFT>;

            label = "SHIFTEND";
        };

        ctHOME: ctHOME {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp HOME>,
                <&macro_release>,
                <&kp HOME &kp LCTRL>;

            label = "CTHOME";
        };

        ctEND: ctEND {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp END>,
                <&macro_release>,
                <&kp END &kp LCTRL>;

            label = "CTEND";
        };

        ctrlPLUS: ctrlPLUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LCTRL>;

            label = "CTRLPLUS";
        };

        ctrlMINUS: ctrlMINUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp MINUS &kp LCTRL>;

            label = "CTRLMINUS";
        };

        ctrlUP: ctrlUP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp UP_ARROW &kp LCTRL>;

            label = "CTRLUP";
        };

