                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp DOWN>,
                <&macro_release>,
                <&kp DOWN_ARROW &kp LCTRL>;

            label = "CTRLDOWN";
        };

        ctrlLEFT: ctrlLEFT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
