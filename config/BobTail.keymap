        };

        altprsc: altprsc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp PRINTSCREEN>,
                <&macro_release>,
                <&kp PRINTSCREEN &kp LEFT_ALT>;

            label = "ALTPRSC";
        };

