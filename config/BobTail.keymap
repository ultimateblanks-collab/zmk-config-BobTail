    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp W              &kp E                 &kp R              &kp T                                                         &kp Y                &kp U           &kp I           &MOL 6 O       &kp P
&kp A    &L_HRM LEFT_ALT S  &L_HRM LCTRL D        &L_HRM LSHFT F     &kp G                &none           &none                    &kp H                &R_HRM LSHFT J  &R_HRM LCTRL K  &R_HRM LALT L  &R_HRM LWIN MINUS
&kp Z    &kp X              &kp C                 &kp V              &kp B                &none           &none                    &kp N                &kp M           &comUS          &periPL        &kp SLASH
&evalue  &none              &THUMB_MO_R 3 ESCAPE  &THUMB_MO_L 2 TAB  &THUMB_MO_L 5 ENTER  &kp DELETE      &THUMB_MO_R 1 BACKSPACE  &THUMB_MO_R 4 SPACE                                                 &carte
            >;

            sensor-bindings = <&mkp45>;
        };

        MB {
            bindings = <
&altf11  &none   &altF3  &altF4  &none                     &none   &none   &none   &none   &none
