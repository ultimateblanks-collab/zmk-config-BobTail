            label = "CTRLV";
        };

        ctrlX: ctrlX {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp X>,
                <&macro_release>,
                <&kp X &kp LCTRL>;

            label = "CTRLX";
        };

        ctrlZ: ctrlZ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp Z>,
                <&macro_release>,
                <&kp Z &kp LCTRL>;

