                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUHS>,
                <&macro_release>,
                <&kp NUHS &kp LSHFT>;

            label = "RMID";
        };

        wintab: wintab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LWIN>,
                <&macro_wait_time 15>,
                <&kp TAB>,
                <&macro_release>,
                <&kp TAB &kp LWIN>;

            label = "WINTAB";
        };

        ctrlW: ctrlW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp W>,
                <&macro_release>,
                <&kp W &kp LCTRL>;

            label = "CTRLW";
        };

        altF4: altF4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp F4>,
                <&macro_release>,
                <&kp F4 &kp LEFT_ALT>;

            label = "ALTF4";
        };

        ctrlT: ctrlT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp T>,
                <&macro_release>,
                <&kp T &kp LCTRL>;

            label = "CTRLT";
        };

        carte: carte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp N3 &kp N7 &kp N0 &kp N8 &kp TAB>,
                <&macro_wait_time 10>,
                <&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp N1 &kp N2 &kp N3 &kp ENTER>;

            label = "CARTE";
        };

        evalue: evalue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp N3 &kp N7 &kp N0 &kp N8 &kp TAB>,
                <&macro_wait_time 10>,
                <&kp N0 &kp N8 &kp N6 &kp N2 &kp ENTER>;

            label = "EVALUE";
        };

        altF3: altF3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp F3>,
                <&macro_release>,
                <&kp F3 &kp LEFT_ALT>;

            label = "ALTF3";
        };

        altf11: altf11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp F11>,
                <&macro_release>,
                <&kp F11 &kp LEFT_ALT>;

            label = "ALTF11";
        };

        shiftapp: shiftapp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp K_CONTEXT_MENU>,
                <&macro_release>,
                <&kp K_CONTEXT_MENU &kp LSHFT>;

            label = "SHIFTAPP";
        };

        altprsc: altprsc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp PRINTSCREEN>,
                <&macro_release>,
                <&kp PRINTSCREEN &kp LEFT_ALT>;

            label = "ALTPRSC";
        };

        shiftHOME: shiftHOME {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp HOME>,
                <&macro_release>,
                <&kp HOME &kp LSHFT>;

            label = "SHIFTHOME";
        };

        shiftEND: shiftEND {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp END>,
                <&macro_release>,
                <&kp END &kp LSHFT>;

            label = "SHIFTEND";
        };

        ctHOME: ctHOME {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp HOME>,
                <&macro_release>,
                <&kp HOME &kp LCTRL>;

            label = "CTHOME";
        };

        ctEND: ctEND {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp END>,
                <&macro_release>,
                <&kp END &kp LCTRL>;

            label = "CTEND";
        };

        ctrlPLUS: ctrlPLUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LCTRL>;

            label = "CTRLPLUS";
        };

        ctrlMINUS: ctrlMINUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp MINUS &kp LCTRL>;

            label = "CTRLMINUS";
        };

        ctrlUP: ctrlUP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp UP_ARROW &kp LCTRL>;

            label = "CTRLUP";
        };

        ctrlDOWN: ctrlDOWN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp DOWN>,
                <&macro_release>,
                <&kp DOWN_ARROW &kp LCTRL>;

            label = "CTRLDOWN";
        };

        ctrlLEFT: ctrlLEFT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LEFT_ARROW &kp LCTRL>;

            label = "CTRLLEFT";
        };

        ctrlRIGHT: ctrlRIGHT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RIGHT &kp LCTRL>;

            label = "CTRLRIGHT";
        };

        ctrlHOME: ctrlHOME {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp HOME>,
                <&macro_release>,
                <&kp HOME &kp LCTRL>;

            label = "CTRLHOME";
        };

        ctrlEND: ctrlEND {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp END>,
                <&macro_release>,
                <&kp END &kp LCTRL>;

            label = "CTRLEND";
        };

        ctrlTAB: ctrlTAB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp TAB>,
                <&macro_release>,
                <&kp TAB &kp LCTRL>;

            label = "CTRLTAB";
        };

        SHIFTctrlTAB: SHIFTctrlTAB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp TAB>,
                <&macro_release>,
                <&kp TAB &kp LCTRL &kp LSHFT>;

            label = "SHIFTCTRLTAB";
        };

        caps: caps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp CAPSLOCK>,
                <&macro_release>,
                <&kp CAPSLOCK &kp LSHFT>;

            label = "CAPS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp W              &kp E                 &kp R              &kp T                                                         &kp Y                &kp U           &kp I           &kp O                 &kp P
&kp A    &L_HRM LEFT_ALT S  &L_HRM LCTRL D        &L_HRM LSHFT F     &kp G                &altF4          &kp K_CONTEXT_MENU       &kp H                &R_HRM LSHFT J  &R_HRM LCTRL K  &R_HRM LALT L         &R_HRM LWIN MINUS
&kp Z    &kp X              &THUMB_MO_R 6 C       &kp V              &kp B                &none           &kp PRINTSCREEN          &kp N                &kp M           &kp COMMA       &THUMB_MO_R 6 PERIOD  &kp SLASH
&evalue  &none              &THUMB_MO_R 3 ESCAPE  &THUMB_MO_L 2 TAB  &THUMB_MO_L 6 ENTER  &kp DELETE      &THUMB_MO_R 1 BACKSPACE  &THUMB_MO_R 4 SPACE                                                        &carte
            >;

            sensor-bindings = <&mkp45>;
        };

        MB {
            bindings = <
&altf11  &none   &altF3  &altF4  &none                     &none   &none   &none   &none   &none
&kp F11  &kp F2  &kp F3  &kp F4  &kp F5  &none      &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F12  &none   &none   &none   &none   &none      &none  &none   &none   &none   &none   &none
&none    &none   &none   &none   &none   &none      &none  &none                           &none
            >;
        };

        BASIC {
            bindings = <
&none     &none         &ctrlHOME  &shiftHOME      &none                          &SHIFTctrlTAB       &ctpgup         &kp UP_ARROW    &ctpgdn     &ctrlTAB
&kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &altesc  &none      &none      &kp HOME            &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT   &kp END
&none     &none         &ctrlEND   &shiftEND       &none    &none      &none      &kp K_CONTEXT_MENU  &ctrlPLUS       &wintab         &ctrlMINUS  &kp PRINTSCREEN
&none     &none         &none      &none           &none    &none      &kp LCTRL  &kp LEFT_ALT                                                    &none
            >;

            sensor-bindings = <&pgupdn>;
        };

        SNIPE {
            bindings = <
&none  &none     &none  &none     &none                    &none  &none      &none      &none         &none
&none  &mkp MB2  &none  &mkp MB1  &none  &none      &none  &none  &kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LWIN
&none  &none     &none  &none     &none  &none      &none  &none  &none      &none      &none         &none
&none  &none     &none  &none     &none  &none      &none  &none                                      &none
            >;
        };

        Num {
            bindings = <
&plus   &kp MINUS  &aster  &kp SLASH  &eql                         &kp EQUAL  &percent  &none   &none   &none
&kp N1  &kp N2     &kp N3  &kp N4     &kp N5     &none      &none  &kp N6     &kp N7    &kp N8  &kp N9  &kp N0
&none   &none      &none   &none      &none      &none      &none  &none      &none     &none   &none   &none
&none   &none      &none   &kp GRAVE  &sk LSHFT  &caps      &none  &none                                &none
            >;
        };

        Function {
            bindings = <
&none    &none   &none   &none   &none                     &none   &none   &none   &none   &none
&kp F11  &kp F2  &F3ALT  &kp F4  &kp F5  &none      &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F12  &none   &none   &none   &none   &none      &none  &none   &none   &none   &none   &none
&none    &none   &none   &none   &none   &none      &none  &none                           &none
            >;
        };

        SYMBOL {
            bindings = <
&ctpgup   &ctrlW    &mkp MB4  &ctrlT     &ctpgdn                        &kp INTERNATIONAL_3  &kp RBKT  &kp NUHS  &kp LBKT  &kp EQUAL
&saltesc  &mkp MB2  &none     &mkp MB1   &altesc  &none          &none  &dollar              &l_kakko  &r_kakko  &anp      &kp APOSTROPHE
&none     &kp HOME  &mkp MB5  &kp END    &none    &none          &none  &us                  &Lmid     &Rmid     &hush     &kp SEMI
&none     &none     &none     &kp LCTRL  &mo 5    &kp LSHFT      &dq    &sq                                                &pl
            >;
        };
    };
};
