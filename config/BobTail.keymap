                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp EQUAL>,
                <&macro_release>,
                <&kp EQUAL &kp LSHFT>;

            label = "TILDE";
        };

        plus: plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LSHFT>;

            label = "PLUS";
        };

        aster: aster {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp SINGLE_QUOTE>,
                <&macro_release>,
                <&kp SINGLE_QUOTE &kp LSHFT>;

            label = "ASTER";
        };

        altesc: altesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp LEFT_ALT>;

            label = "ALTESC";
        };

        saltesc: saltesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT &kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp LEFT_ALT &kp LSHFT>;

            label = "SALTESC";
        };

        ctpgup: ctpgup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp PG_UP>,
                <&macro_release>,
                <&kp PG_UP &kp LCTRL>;

            label = "CTPGUP";
        };

        ctpgdn: pgdn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp PAGE_DOWN>,
                <&macro_release>,
                <&kp PAGE_DOWN &kp LCTRL>;

            label = "PGDN";
        };

        Lmid: Lmid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp RBKT>,
                <&macro_release>,
                <&kp RBKT &kp LSHFT>;

            label = "LMID";
        };

        Rmid: Rmid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
